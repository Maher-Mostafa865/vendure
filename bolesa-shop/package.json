{
  "name": "bolesa-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/link-nestjs-for-nestlens.js",
    "dev": "concurrently -n server,storefront -c blue,magenta \"npm run dev -w server\" \"npm run dev -w storefront\"",
    "dev:server": "npm run dev:server -w server",
    "dev:worker": "npm run dev:worker -w server",
    "dev:storefront": "npm run dev -w storefront",
    "build": "npm run build -w server && npm run build -w storefront",
    "build:server": "npm run build -w server",
    "build:storefront": "npm run build -w storefront",
    "start": "concurrently -n server,storefront -c blue,magenta \"npm run start:server -w server\" \"npm run start -w storefront\"",
    "start:server": "npm run start:server -w server",
    "start:worker": "npm run start:worker -w server",
    "start:storefront": "npm run start -w storefront"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "nestlens": {
      "@nestjs/common": "12.5.1",
      "@nestjs/core": "12.5.1"
    }
  },
  "allowScripts": {
    "bcrypt": true,
    "esbuild": true,
    "sharp": true
  }
}
