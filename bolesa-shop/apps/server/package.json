{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "vendure dev server",
    "dev:worker": "vendure dev worker",
    "dev:dashboard": "vendure dev dashboard",
    "dev": "vendure dev all",
    "build": "vendure build all",
    "build:server": "vendure build server",
    "build:worker": "vendure build worker",
    "build:dashboard": "vendure build dashboard",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "vendure start all",
    "test:bolesa": "node --import tsx --test src/plugins/bolesa/tests/*.spec.ts",
    "test:bolesa:migrate": "TS_NODE_PROJECT=tsconfig.integration.json node -r reflect-metadata -r ts-node/register src/plugins/bolesa/tests/integration/migrate-test-db.ts",
    "test:bolesa:integration": "TS_NODE_PROJECT=tsconfig.integration.json node -r reflect-metadata -r ts-node/register --test --test-concurrency=1 --test-timeout=120000 src/plugins/bolesa/tests/integration/*.integration.spec.ts",
    "test:bolesa:sandbox-e2e": "BOLESA_SANDBOX_E2E=1 TS_NODE_PROJECT=tsconfig.integration.json node -r reflect-metadata -r ts-node/register --test --test-concurrency=1 --test-timeout=300000 src/plugins/bolesa/tests/integration/sandbox-e2e.integration.spec.ts src/plugins/bolesa/tests/integration/full-flow-e2e.integration.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vendure/asset-server-plugin": "3.8.2",
    "@vendure/core": "3.8.2",
    "@vendure/dashboard": "3.8.2",
    "@vendure/email-plugin": "3.8.2",
    "@vendure/graphiql-plugin": "3.8.2",
    "dotenv": "18.0.10",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@vendure/cli": "3.8.2",
    "ts-node": "10.9.2",
    "tsx": "^4.20.5",
    "typescript": "5.8.2",
    "vite": "7.3.8"
  }
}
