# Official remote Bolesa Sandbox only — never put local 127.0.0.1 credentials here.
# Copy to gitignored `.env.remote-sandbox` and fill with real Sandbox values.

BOLESA_ENV_IDENTITY=official-remote-sandbox
BOLESA_API_BASE_URL=https://REPLACE_OFFICIAL_SANDBOX_HOST/api/pcl/v1
BOLESA_PARTNER_TOKEN=xp_REPLACE_SANDBOX_TOKEN
BOLESA_REMOTE_SANDBOX_ALLOWED_HOSTS=REPLACE_OFFICIAL_SANDBOX_HOST
# Optional: assert /me account id matches
# BOLESA_EXPECTED_ACCOUNT_ID=
